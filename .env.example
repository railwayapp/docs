NEXT_PUBLIC_RAILWAY_DOCS_URL = 
EXPORT_ENDPOINT_PASSWORD = 'password'
NEXT_PUBLIC_POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Do11y — documentation observability (https://github.com/manototh/do11y)
# Leave the URL and key blank to disable it. These are inlined at build time,
# so they must be present in the Railway build environment.
NEXT_PUBLIC_DO11Y_SUPABASE_URL=
NEXT_PUBLIC_DO11Y_SUPABASE_KEY=
NEXT_PUBLIC_DO11Y_TABLE=do11y_events
# Comma-separated hosts allowed to send events. Any other host disables
# tracking entirely, which keeps localhost and PR previews out of the data.
# Use an empty value to allow any host (handy when testing locally).
NEXT_PUBLIC_DO11Y_ALLOWED_DOMAINS=docs.railway.com
# Force verbose logging. Defaults to on outside production.
NEXT_PUBLIC_DO11Y_DEBUG=
# Set to "false" to turn instrumentation off without removing credentials.
NEXT_PUBLIC_DO11Y_ENABLED=

# Local search (Meilisearch)
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_READ_API_KEY=local_master_key
NEXT_PUBLIC_MEILISEARCH_INDEX_NAME=docs_local_dev
